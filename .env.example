# ─── Bridge server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Protects THIS bridge's endpoints. Send it as: X-Api-Key: <value>
# Generate one with:  openssl rand -hex 32
BRIDGE_API_KEY=replace-with-a-long-random-secret

# ─── Qontak / Mekari credentials ─────────────────────────────────
# Obtained from the Mekari Developer portal (follow the slides up to page 9).
MEKARI_CLIENT_ID=your-mekari-client-id
MEKARI_CLIENT_SECRET=your-mekari-client-secret

# Mekari API gateway base URL.
QONTAK_BASE_URL=https://api.mekari.com

# Path to the Qontak "direct" WhatsApp broadcast endpoint on the Mekari gateway.
# IMPORTANT: confirm this exact path from your Postman collection / docs.
# The HMAC signature is computed over this path, so it must match byte-for-byte.
QONTAK_BROADCAST_DIRECT_PATH=/qontak/chat/v1/broadcasts/whatsapp/direct

# ─── Defaults for WhatsApp sends (can be overridden per request) ──
# The connected WABA channel inside Qontak.
QONTAK_CHANNEL_INTEGRATION_ID=
# Default approved message template id + language.
QONTAK_MESSAGE_TEMPLATE_ID=
QONTAK_LANGUAGE_CODE=id

# ─── Broadcast tuning ────────────────────────────────────────────
# Max messages sent concurrently during a broadcast.
BROADCAST_CONCURRENCY=3
# Delay (ms) added after each send to respect provider rate limits.
BROADCAST_DELAY_MS=250
